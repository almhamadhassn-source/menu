# TEMPORARY: runs the whole site on in-memory fake data (see src/lib/mock-db.ts) instead of
# Supabase — no network needed. Set to 0 (or delete the line) once you're ready to connect the
# real database and run supabase/schema.sql + seed.sql.
NEXT_PUBLIC_MOCK_DATA=0

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets — never prefix with NEXT_PUBLIC_, never sent to the browser.
# Service role key: Supabase dashboard -> Project Settings -> API -> service_role secret.
# Used only from Server Actions, after the staff session (see src/lib/dal.ts) is already verified.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string (e.g. `openssl rand -base64 32`). Used to hash staff PIN codes
# (src/lib/pin.ts) and to sign staff session cookies (src/lib/dal.ts).
STAFF_CODE_PEPPER=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-a-long-random-string
